# Desenvolvimento local. Nunca versionar credenciais reais.
APP_ENV=local
HOST=0.0.0.0
PORT=3000
DATA_DIR=/data
# Origem exata do navegador, sem barra/caminho. HTTPS, ou HTTP apenas em loopback.
# Exemplo local: APP_ORIGIN=http://localhost:3000. Vazio mantém a autenticação pendente.
APP_ORIGIN=
# E-mails fictícios: participante@example.test,colega@example.test. Vazio desabilita contas.
PILOT_ALLOWED_EMAILS=
PI_CODING_AGENT_DIR=/data/pi
PI_PROVIDER=
PI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
