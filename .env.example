# Desenvolvimento local. Nunca versionar credenciais reais.
APP_ENV=local
HOST=0.0.0.0
PORT=3000
DATA_DIR=/data
# Origem exata do navegador, sem barra/caminho. HTTPS, ou HTTP apenas em loopback.
# Exemplo local: APP_ORIGIN=http://localhost:3000. Vazio mantém a autenticação pendente.
APP_ORIGIN=
# Aplicações públicas HTTP/HTTPS são aceitas sem lista de domínios.
# Somente local/development: exceções explícitas para alvos controlados de teste.
# Origens exatas, separadas por vírgula. Ex.: http://127.0.0.1:4000
# Production ignora essas exceções e sempre bloqueia destinos não públicos.
TARGET_ALLOWED_ORIGINS=
PI_CODING_AGENT_DIR=/data/pi
# Opcional: auth.json privado deste ambiente, criado pelo /login nativo do Pi.
# Vazio usa somente credenciais do ambiente, sem procurar o Pi pessoal.
# Container: /data/pi/auth.json; local: caminho absoluto para .data/pi/auth.json.
PI_AUTH_PATH=
# Provedor e modelo globais para os especialistas
PI_PROVIDER=
PI_MODEL=
# Nível de raciocínio global opcional ('off', 'low', 'high'). Na ausência, aplica o padrão do modelo:
# DeepSeek deepseek-v4-pro -> high; deepseek-flash -> low; demais -> off.
PI_THINKING_LEVEL=
# Substituições por papel. Cada papel exige provider e model juntos.
# Níveis de raciocínio suportados: 'off', 'low', 'high'.
# Configuração padrão com DeepSeek:
# Curator: deepseek / deepseek-flash / low
# Planner: deepseek / deepseek-v4-pro / high
# Validator: deepseek / deepseek-v4-pro / high
PI_CURATOR_PROVIDER=
PI_CURATOR_MODEL=
PI_CURATOR_THINKING_LEVEL=
PI_PLANNER_PROVIDER=
PI_PLANNER_MODEL=
PI_PLANNER_THINKING_LEVEL=
PI_VALIDATOR_PROVIDER=
PI_VALIDATOR_MODEL=
PI_VALIDATOR_THINKING_LEVEL=
# Perfis visuais (T8.2): executor e validador visual do mapa. Cada perfil exige o par
# provider/model; o raciocínio padrão é 'high' (deepseek/deepseek-flash/high no card).
# O validador textual acima permanece em Pro/high; não há fallback silencioso de modelo.
PI_EXECUTOR_PROVIDER=
PI_EXECUTOR_MODEL=
PI_EXECUTOR_THINKING_LEVEL=
PI_VALIDATOR_VISUAL_PROVIDER=
PI_VALIDATOR_VISUAL_MODEL=
PI_VALIDATOR_VISUAL_THINKING_LEVEL=
# Alternativa ao OAuth: chave do provedor no ambiente privado.
# Não carregamos sessões/auth pessoais automaticamente.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Redação do relatório, conferida somente ao iniciar esta etapa.
PI_REPORT_PROVIDER=deepseek
PI_REPORT_MODEL=deepseek-flash
PI_REPORT_THINKING_LEVEL=low
